const FIELDS=[['sku','SKU'],['bar','Código de barras'],['desc','Descrição'],['exc','Data de exclusão'],['sl','Saldo loja'],['sg','Saldo logística']];
const TR={RETIRAR:'RETIRAR GANCHO',FICHA:'FICHA DE RUPTURA',CONTAGEM:'ENCAMINHAR PARA CONTAGEM'};
const FLRE=/(^|[^A-Za-zÀ-ÿ0-9])(F\/L|FL)(?=$|[^A-Za-zÀ-ÿ0-9])/i;

let table=null,map={},idx=new Map(),res={},order=[],mode='analisar',hist=[];

async function initApp() {
  await loadProductsFromSupabase();
  await loadTreatmentsFromSupabase();
  setupRealtime();
}

async function loadProductsFromSupabase() {
  const { data, error } = await supabase.from('products').select('*');
  if (!error && data && data.length > 0) {
    idx = new Map();
    data.forEach(x => {
      idx.set(norm(x.sku), x);
      if(x.bar) str(x.bar).split(/[;,|\/\s]+/).forEach(t => {
        const k = norm(t);
        if(k && !idx.has(k)) idx.set(k, x);
      });
    });
    $('#baseInfo').textContent = `Base sincronizada: ${data.length} produtos carregados da nuvem.`;
  }
}

