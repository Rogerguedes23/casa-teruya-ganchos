<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tratativa de Ganchos — Casa Teruya</title>
<meta name="theme-color" content="#002F1B">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700;900&display=swap" rel="stylesheet">
<!-- Supabase SDK -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{--bg:#F2EFED;--card:#FFFFFF;--tx:#212121;--mut:#4E4E4C;--bd:#E2DCD8;--rd:#BD0000;--gr:#002F1B;--gm:#3A8E5C;--or:#FF8A0D;--pk:#F9D2DB;--h:#BD0000;--inp:#F2EFED;--ring:#BD0000;box-sizing:border-box;padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0B1812;--card:#122419;--tx:#F2EFED;--mut:#AEBBB3;--bd:#274434;--h:#F46262;--inp:#0B1812;--pk:#4F0B0B;--ring:#FF8A0D}}
:root[data-theme="dark"]{--bg:#0B1812;--card:#122419;--tx:#F2EFED;--mut:#AEBBB3;--bd:#274434;--h:#F46262;--inp:#0B1812;--pk:#4F0B0B;--ring:#FF8A0D}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.45 "Hanken Grotesk",Verdana,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.top{background:var(--gr);padding:calc(env(safe-area-inset-top,0px) + 14px) 16px 14px}
.top .in{max-width:760px;margin:0 auto}
main{max-width:760px;margin:0 auto;padding:16px}
h1{display:flex;align-items:center;gap:10px;font-size:22px;font-weight:700;color:var(--h);margin:4px 0 14px}
h1::before{content:"";width:14px;height:20px;background:var(--rd);clip-path:polygon(0 0,55% 0,100% 50%,55% 100%,0 100%);flex:none}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-bottom:12px}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
button,select,input,textarea{font:inherit;color:var(--tx)}
button{background:var(--card);border:1px solid var(--bd);border-radius:8px;padding:8px 12px;cursor:pointer;font-weight:500}
button:focus-visible,select:focus-visible{outline:3px solid var(--or);outline-offset:1px}
button.p{background:var(--rd);color:#fff;border-color:var(--rd);font-weight:700}
button.on{background:var(--gr);color:#fff;border-color:var(--gr);font-weight:700}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) button.on{background:var(--or);color:#002F1B;border-color:var(--or)}}
:root[data-theme="dark"] button.on{background:var(--or);color:#002F1B;border-color:var(--or)}
input[type=text]{flex:1;min-width:0;font-size:20px;padding:12px;border:2px solid var(--bd);border-radius:10px;background:var(--inp)}
input[type=text]:focus{outline:none;border-color:var(--ring)}
select{background:var(--inp);border:1px solid var(--bd);border-radius:6px;padding:4px}
.mut{color:var(--mut);font-size:14px}
.tabs{display:flex;gap:6px;margin-bottom:12px}.tabs button{flex:1}
.blk{font-size:16px;line-height:1.8}
.badge{display:inline-block;padding:3px 20px 3px 12px;font-weight:700;font-size:14px;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 50%,calc(100% - 10px) 100%,0 100%)}
.RETIRAR{background:var(--rd);color:#fff}.FICHA{background:var(--or);color:#002F1B}.CONTAGEM{background:var(--gr);color:#fff}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .CONTAGEM{background:var(--gm);color:#fff}}
:root[data-theme="dark"] .CONTAGEM{background:var(--gm);color:#fff}
.msg{padding:12px;border-radius:10px;background:var(--pk);color:var(--rd);font-weight:700;border-left:5px solid var(--rd)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .msg{color:#FFC9C9}}
:root[data-theme="dark"] .msg{color:#FFC9C9}
.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:14px}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--bd);white-space:nowrap}
th{font-weight:700;border-bottom:2px solid var(--or)}
textarea{width:100%;min-height:110px;background:var(--inp);border:1px solid var(--bd);border-radius:8px;padding:8px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px}
.stat{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--bd);font-size:18px}
.stat strong{font-weight:900}
h2{font-size:17px;font-weight:700;color:var(--h);margin:0 0 10px}
.hid{display:none}
</style>
</head>
<body>
<header class="top"><div class="in"><span style="color:#fff;font-weight:900;font-size:20px;">CASA TERUYA</span></div></header>
<main>
<h1>Tratativa de ganchos</h1>

<div class="card" id="baseCard">
  <div class="row"><input type="file" id="file" accept=".xlsx,.xls,.csv,.tsv"><span class="mut" id="baseInfo">Carregue a base de SKUs (Excel ou CSV) para sincronizar com o Supabase.</span></div>
  <div id="mapBox" class="hid" style="margin-top:10px">
    <div class="mut">Confira as colunas:</div>
    <div class="row" id="mapSel" style="margin-top:6px"></div>
    <button class="p" id="okMap" style="margin-top:10px">Salvar base no Supabase</button>
  </div>
</div>

<div class="tabs">
  <button data-t="an" class="on">Analisar</button>
  <button data-t="rel">Relatório</button>
  <button data-t="res">Resumo</button>
</div>

<section id="an">
  <div class="card">
    <div class="row" style="margin-bottom:10px">
      <button data-m="analisar" class="on">Analisar</button>
      <button data-m="consultar">Consultar SKU</button>
    </div>
    <div class="row"><input type="text" id="code" placeholder="SKU ou código de barras" autocomplete="off" inputmode="text"><button class="p" id="go">OK</button></div>
    <div class="mut" style="margin-top:6px">A busca aceita SKU ou código de barras. Dados sincronizados em tempo real.</div>
  </div>
  <div id="out"></div>
  <div id="hist"></div>
</section>

<section id="rel" class="hid">
  <div class="card">
    <h2>Encaminhar para contagem</h2>
    <div class="scroll" id="relTbl"></div>
    <div id="relTot" style="margin-top:10px;font-weight:600"></div>
  </div>
  <div class="card">
    <h2>Retirar gancho</h2>
    <div class="scroll" id="relRet"></div>
    <div id="relRetTot" style="margin-top:10px;font-weight:600"></div>
  </div>
  <div class="card">
    <h2>Ficha de ruptura</h2>
    <div class="scroll" id="relFic"></div>
    <div id="relFicTot" style="margin-top:10px;font-weight:600"></div>
  </div>
  <div class="card">
    <div class="row" style="margin-bottom:8px"><strong>Exportar</strong><button id="cp">Copiar para planilha</button><button id="clr">Limpar sessões na nuvem</button></div>
    <div class="row" style="margin-bottom:8px"><button data-x="CONTAGEM" class="on">Contagem</button><button data-x="RETIRAR">Retirar gancho</button><button data-x="FICHA">Ficha de ruptura</button></div>
    <textarea id="tsv" readonly></textarea>
  </div>
</section>

<section id="res" class="hid"><div class="card" id="resBox"></div></section>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
// CONFIGURAÇÃO DO SUPABASE
const SUPABASE_URL = 'https://incjjuymlcisoacmklcy.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_DhrPY16l25xQhbCO1Rc05g_1OTYouE4';
const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
